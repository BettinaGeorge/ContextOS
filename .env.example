# Copy to .env and fill in real values. Never commit .env.
# See specs/001-trace-doc-to-code/quickstart.md for setup instructions.

# --- Supabase (Postgres + pgvector + Auth) ---
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- LLM / embeddings (ADR-001 rev. 2: free tier, no card — see ADR-001 for why
# Anthropic was ruled out) ---
GROQ_API_KEY=
VOYAGE_API_KEY=

# --- GitHub connector ---
GITHUB_TOKEN=

# --- Notion connector ---
NOTION_TOKEN=

# --- Connector token encryption (T020) — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" ---
TOKEN_ENCRYPTION_KEY=

# --- Frontend (frontend/.env.local should mirror the public-safe subset of these) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
